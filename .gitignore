# xmake and build outputs
/.xmake/
/build/
/install/
/out/

# CMake-generated files
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/compile_commands.json
/cmake-build-*/

# Runtime-generated logs and traces
/logs/*
!/logs/.gitkeep

# Test and coverage artifacts
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
/Testing/

# Editor and language-server files
/.clangd/
/.ccls-cache/
/.idea/
/.vscode/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db

# Crash dumps
/core
/core.*
/vgcore.*

# 离线回放录像：单个 avi 数百 MB，records/ 整体 3 GB，不进仓库
/records/
# 测试产物，以及顺手丢进 tests/ 的本地录像。tests/ 下的源码必须跟踪：xmake 按
# 文件名生成 target，漏掉一个就等于这条链路在别人机器上没有测试。
# （曾写成 /tests/*，结果每加一个冒烟测试都要 git add -f，实际全被漏掉过。）
/tests/output/
/tests/**/*.avi
/tests/**/*.mp4

# 灯条数据集的准备与清洗脚本。它们是一次性的数据加工工具，依赖 roboflow 导出
# 的本地目录结构，换台机器就跑不了，不属于视觉程序本身。
/tools/clean_lightbar_dataset.py
/tools/prepare_lightbar_dataset.py
/tools/build_final_lightbar_dataset.py
/tools/prepare_yolo_armor_lightbar_dataset.py
/tools/test_light_model.py
/tools/test_light_pipeline.py
__pycache__/

# OpenVINO GPU 编译时吐出的 kernel 诊断文件
/kernel.errors.txt
