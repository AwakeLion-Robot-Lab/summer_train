# xmake and build outputs
/.xmake/
/build/
/install/
/out/
*.o
*.obj
*.d
*.gch
*.pch

# CMake-generated files
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/compile_commands.json
/cmake-build-*/

# Runtime-generated logs and traces
/logs/*
!/logs/.gitkeep

# Local camera captures and generated calibration reports
/calibration_images/
/calibration_results/

# Test and coverage artifacts
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata
/Testing/

# Editor and language-server files
/.clangd/
/.ccls-cache/
/.idea/
/.vscode/
/.cache/
*.swp
*.swo
*~
*.tmp
*.temp

# OS-generated files
.DS_Store
Thumbs.db

# Crash dumps
/core
/core.*
/vgcore.*

# 离线回放录像：单个 avi 数百 MB，records/ 整体 3 GB，不进仓库
/records/
/simulator/
/video/

# 本地测试数据默认忽略；统一保留 smoke 测试源码。
/tests/*
!/tests/*_smoke.cpp

# OpenVINO GPU 编译时吐出的 kernel 诊断文件
/kernel.errors.txt
